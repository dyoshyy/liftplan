{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liftplan-web",
  "compatibility_date": "2026-09-01",

  // 静的資産だけを配る Worker。サーバーコードは持たない。
  // API は Cloud Run 側にあり、クロスオリジンで叩く。
  "assets": {
    "directory": "./dist",
    // 実体のあるパスが先に当たるので、/dev.html はその中身が返る。
    // 当たらなかったパスだけ index.html に落ちる（メインの画面は
    // ルーターを持たないため）。この順序が /dev.html を成り立たせている。
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}
