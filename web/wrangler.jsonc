{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "liftplan-web",
  "compatibility_date": "2026-09-01",

  // 静的資産だけを配る Worker。サーバーコードは持たない。
  // API は Cloud Run 側にあり、クロスオリジンで叩く。
  "assets": {
    "directory": "./dist",
    // 実体のあるパス（/dev.html）はそのまま配る。未知のパスは
    // index.html を返す。メインの画面はルーターを持たないため。
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}
